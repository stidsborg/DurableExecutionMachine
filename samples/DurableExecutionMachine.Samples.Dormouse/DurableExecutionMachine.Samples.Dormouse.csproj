<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dormouse</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" Version="6.28.0" />
    <!-- Wolverine generates the handler glue code at runtime; this package supplies the compiler -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.28.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DurableExecutionMachine.csproj" />
  </ItemGroup>

</Project>
